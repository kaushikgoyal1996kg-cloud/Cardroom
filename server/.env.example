# Port the game server listens on. Most hosts set this automatically.
PORT=3001

# Comma-separated list of origins allowed to connect.
# Must include your Netlify site, or every browser will block the connection.
# Example:
# ALLOWED_ORIGINS=https://cardroom.netlify.app,https://cardroom-staging.netlify.app
ALLOWED_ORIGINS=http://localhost:5173

# Optional managed TURN fallback for voice calls on restrictive networks.
# Configure these ONLY on the backend (for example Render -> Environment).
# Never put the Secret Key in a VITE_* variable or client build.
# METERED_DOMAIN=your-app.metered.live
# METERED_SECRET_KEY=replace-with-your-metered-secret-key
