# Address of the Socket.IO backend.
#
# Local development:
VITE_SERVER_URL=http://localhost:3001
#
# Testing from a phone on the same Wi-Fi - use your computer's LAN address:
# VITE_SERVER_URL=http://192.168.1.23:3001
#
# Production - set this in the Netlify UI, not in this file:
# VITE_SERVER_URL=https://your-backend.onrender.com
#
# If this is missing from a production build the app now shows a clear
# error instead of silently trying to reach the player's own phone.
