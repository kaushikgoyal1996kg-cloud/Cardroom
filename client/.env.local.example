# Copy this to .env.local and fill in your computer's LAN IP to test on a
# phone over the same WiFi network. Example:
#
# VITE_SERVER_URL=http://192.168.1.23:3001
#
# Find your LAN IP:
#   Mac:     System Settings -> Wi-Fi -> Details -> IP Address
#            (or: ipconfig getifaddr en0)
#   Windows: ipconfig  (look for "IPv4 Address" under your WiFi adapter)
#   Linux:   ip addr show  (or: hostname -I)
VITE_SERVER_URL=http://localhost:3001

# Voice call TURN server credentials (optional but recommended - see
# https://dashboard.metered.ca/signup for a free account). Without these,
# voice calling still works but falls back to STUN-only, which can fail to
# connect for players on certain mobile networks. Get your username and
# credential from the Metered.ca dashboard's "TURN Server" page after
# clicking "Generate Your First Credential".
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
